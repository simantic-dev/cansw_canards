# HSE is a 4 MHz crystal (cansw_canard_board_h723.ioc: RCC.HSE_VALUE=4000000)
rcc:
    hseFrequency: 4000000
card: SD.SDCard @ sdmmc2
    capacity: 0x4000000
motor: CAN.ScriptedCanNode @ sysbus 0x60100000
    file: "sim/peers/ak45_motor.py"
    baudRate: 1000000
ground: CAN.ScriptedCanNode @ sysbus 0x60100100
    file: "sim/peers/ground.py"
    baudRate: 250000
imu: I2C.ScriptedI2cSlave @ i2c1 0x6A
    file: "sim/peers/lsm6dsv32x.py"
mag: I2C.ScriptedI2cSlave @ i2c4 0x1E
    file: "sim/peers/iis2mdc.py"
baro: I2C.ScriptedI2cSlave @ i2c5 0x77
    file: "sim/peers/ms5611.py"
drdy: Scripted.ScriptedGpioPeer @ none
    file: "sim/peers/drdy.py"
    numberOfGpios: 2
    0 -> gpioPortD@7
    1 -> gpioPortE@0
